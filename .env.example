# slowquery-demo-backend
#
# Copy to .env and fill in every non-commented line. `.env` is git-ignored.

# --- runtime ---
APP_ENV=development                                       # development | production
LOG_LEVEL=info                                            # debug | info | warning | error
PORT=8000
DEMO_MODE=false                                           # true: a request WITHOUT a token proceeds anonymous (an invalid token is still 401)

# --- Public-URL mutation hardening (enforced even under DEMO_MODE) ---
DEMO_MUTATION_COOLDOWN_S=0                                 # per-client cooldown (s) on switch/force-explain; 0 disables
# shared secret; force-explain is 403 until set. Sent as X-Admin-Token
DEMO_MUTATION_TOKEN=

# A blank value must stay alone on its line: `KEY=   # comment` reads as the
# value "# comment" (python-dotenv), which would e.g. set a guessable
# DEMO_MUTATION_TOKEN. Comments go on the line above.

# --- Platform token contract v2 (docs/specs/14-platform-contract-v2.md) ---
# Service id "slowquery" is a constant in code. With neither key configured every
# protected route answers 503 platform_auth_unconfigured (unless APP_ENV=test).
# bastion's Ed25519 key, base64 SPKI DER; admits iss "bastion"
BASTION_SIGNING_KEY_PUBLIC=
# else JSON {"publicKey": "..."} fetched async + cached 1h
BASTION_PUBLIC_KEY_URL=
# the dashboard's key, base64 SPKI DER; admits iss "slowquery-frontend", role "frontend"
SLOWQUERY_FRONTEND_SIGNING_KEY_PUBLIC=

# --- Neon Postgres (two branches for the live slow/fast switch) ---
# The `slowquery` branch is seeded without indexes (1M orders, 5M order_items).
# The `slowquery-fast` branch has the same rows + the 3 missing indexes added.
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/slowquery?sslmode=require
DATABASE_URL_FAST=postgresql+asyncpg://USER:PASS@HOST/slowquery-fast?sslmode=require
BRANCH_CURRENT=slow                                       # slow | fast

# --- slowquery-detective middleware tunables ---
SLOWQUERY_THRESHOLD_MS=100                                # any query > this is captured
SLOWQUERY_SAMPLE_RATE=1.0                                 # 0.0-1.0; 1.0 = sample every call
# defaults to DATABASE_URL when blank
SLOWQUERY_STORE_URL=

# --- Neon API: not used ---
# POST /branches/switch does NOT call the Neon API. Spec 06 rules that out
# (latency + secrets-leak hazard in a request handler); a switch swaps between
# DATABASE_URL and DATABASE_URL_FAST above and rebuilds the SQLAlchemy engine.
# NEON_API_KEY / NEON_PROJECT_ID used to be listed here and read by nothing.

# --- OpenRouter LLM fallback (for the rules-engine explainer) ---
# Keep false unless OPENROUTER_API_KEY is set — enabling without a key fails boot.
LLM_FALLBACK_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# blank keeps the code default, the free google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL_PRIMARY=

# --- CORS ---
CORS_ORIGINS=https://slowquery-dashboard-frontend.vercel.app,http://localhost:3000
