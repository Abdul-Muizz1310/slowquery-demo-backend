# slowquery-demo-backend
#
# Copy to .env and fill in every non-commented line. `.env` is git-ignored.

# --- runtime ---
APP_ENV=development                                       # development | production
LOG_LEVEL=info                                            # debug | info | warning | error
PORT=8000
DEMO_MODE=true                                            # demo mode accepts any X-Platform-Token

# --- Public-URL mutation hardening (enforced even under DEMO_MODE) ---
DEMO_MUTATION_COOLDOWN_S=0                                 # per-client cooldown (s) on switch/force-explain; 0 disables
DEMO_MUTATION_TOKEN=                                       # shared secret; force-explain is 403 until set. Sent as X-Admin-Token

# --- Platform-token enforcement (only used when DEMO_MODE=false) ---
# Bastion's Ed25519 public key, either inline (base64 DER) or fetched from a URL.
BASTION_SIGNING_KEY_PUBLIC=                               # base64 DER; takes precedence over the URL
BASTION_PUBLIC_KEY_URL=                                   # JSON {"publicKey": "..."}; fetched async + cached 1h
# Optional claims validation (cross-service replay defence, SEC-1). When set,
# a signature-valid token minted for another service/role is rejected.
BASTION_EXPECTED_ISSUER=                                  # passed to jwt.decode(issuer=...) when set
BASTION_EXPECTED_AUDIENCE=                                # passed to jwt.decode(audience=...) when set
BASTION_EXPECTED_SERVICE=                                 # must equal the token's `service` claim
BASTION_ALLOWED_ROLES=                                    # comma-separated allow-list for the `role` claim

# --- Neon Postgres (two branches for the live slow/fast switch) ---
# The `slowquery` branch is seeded without indexes (1M orders, 5M order_items).
# The `slowquery-fast` branch has the same rows + the 3 missing indexes added.
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/slowquery?sslmode=require
DATABASE_URL_FAST=postgresql+asyncpg://USER:PASS@HOST/slowquery-fast?sslmode=require
BRANCH_CURRENT=slow                                       # slow | fast

# --- slowquery-detective middleware tunables ---
SLOWQUERY_THRESHOLD_MS=100                                # any query > this is captured
SLOWQUERY_SAMPLE_RATE=1.0                                 # 0.0-1.0; 1.0 = sample every call
SLOWQUERY_STORE_URL=                                      # defaults to DATABASE_URL when blank
SLOWQUERY_SAMPLE_RETENTION_S=86400                        # prune query_samples older than this; 0 disables
SLOWQUERY_STATS_RECOMPUTE_INTERVAL_S=2.0                  # min seconds between percentile recomputes per fingerprint

# --- Neon API (for POST /branches/switch live branch swap) ---
NEON_API_KEY=
NEON_PROJECT_ID=

# --- OpenRouter LLM fallback (for the rules-engine explainer) ---
# Keep false unless OPENROUTER_API_KEY is set — enabling without a key fails boot.
LLM_FALLBACK_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_PRIMARY=                                 # picked at integration time

# --- CORS ---
CORS_ORIGINS=https://slowquery-dashboard-frontend.vercel.app,http://localhost:3000
